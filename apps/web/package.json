{
  "name": "@punktlandung/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && bun run build:preview-seed",
    "build:preview-seed": "bun build scripts/seed-preview.ts --target=bun --packages=external --outfile=dist/preview-seed/seed-preview.js",
    "start": "bun run scripts/serve.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test && bun run test:stories",
    "test:stories": "playwright install chromium && playwright test --config playwright-stories.config.ts",
    "test:a11y": "playwright install chromium && playwright test --config playwright.config.ts",
    "db:generate": "bun --env-file=.env.local run drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local run scripts/migrate.ts",
    "db:migrate:deploy": "bun run scripts/migrate.ts",
    "db:seed:preview": "bun run dist/preview-seed/seed-preview.js",
    "db:push": "bun --env-file=.env.local run drizzle-kit push",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio"
  },
  "dependencies": {
    "@effect/sql-pg": "4.1.2",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@punktlandung/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-query-devtools": "^5.105.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.15",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.2",
    "lucide-react": "1.66.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/router-cli": "^1.167.46",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
